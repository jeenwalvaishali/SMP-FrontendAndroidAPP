<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONDAY"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor"
            android:layout_marginBottom="16dp"/>

        <!-- Breakfast -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌅 BREAKFAST"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>
        <TextView
            android:id="@+id/breakfastTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vegetable Poha"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/breakfastCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="350 Calories"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp"/>

        <!-- Lunch -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ LUNCH"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>
        <TextView
            android:id="@+id/lunchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paneer Bowl"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/lunchCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="700 Calories"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="12dp"/>

        <!-- Dinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 DINNER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#888888"/>
        <TextView
            android:id="@+id/dinnerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dal + Rice"
            android:textSize="16sp"
            android:textColor="@color/text_primary"/>
        <TextView
            android:id="@+id/dinnerCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="750 Calories"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView
                android:id="@+id/totalDayCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1800 / 2000 Calories"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
